{
  "manifest_version": 3,
  "name": "Claude Excel 取数",
  "version": "0.4.4",
  "description": "打开网页即监听接口表；也可点选同类或框选，送到本机 Excel。密码不进模型。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "抓到 Excel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["json-table.js", "net-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["json-table.js", "picker.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8766/*", "https://*/*", "http://*/*"]
}
