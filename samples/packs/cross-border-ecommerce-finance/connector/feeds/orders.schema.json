{
  "feedId": "orders",
  "sheetName": "Pack_订单",
  "description": "Canonical order lines for reconcile / profit recipe (ERP or CSV source)",
  "primaryKeys": ["platform_sku", "biz_date"],
  "columns": [
    { "name": "order_id", "type": "string", "required": true },
    { "name": "order_date", "type": "date", "required": true, "note": "ISO date, local biz timezone" },
    { "name": "platform_sku", "type": "string", "required": true, "note": "trimmed, ERP-normalized" },
    { "name": "asin", "type": "string", "required": false },
    { "name": "quantity", "type": "number", "required": true },
    { "name": "item_price", "type": "number", "required": true },
    { "name": "currency", "type": "string", "required": true },
    { "name": "order_status", "type": "string", "required": false },
    { "name": "is_refund", "type": "boolean", "required": false },
    { "name": "biz_date", "type": "date", "required": true, "note": "对账 join 键；orders 取自 order_date" },
    { "name": "marketplace_id", "type": "string", "required": false, "note": "Phase 2 预留：多站点标识" },
    { "name": "traffic_source_tag", "type": "string", "required": false, "note": "Phase 2 预留：Lazada 订单级流量标记" },
    { "name": "rate_lock_type", "type": "string", "required": false, "note": "Phase 2 预留：锁价/浮价" },
    { "name": "raw_erp_status", "type": "string", "required": false, "note": "审计列：ERP 原始状态，recipe 不读" }
  ]
}
