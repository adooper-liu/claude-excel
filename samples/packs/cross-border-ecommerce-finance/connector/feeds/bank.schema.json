    { "name": "ref", "type": "string", "required": false },
    { "name": "settlement_id", "type": "string", "required": false, "note": "Optional; when present enables exact match mode" },
    { "name": "biz_date", "type": "date", "required": true, "note": "join key; from txn_date" },
    { "name": "raw_erp_status", "type": "string", "required": false }
  ]
}
